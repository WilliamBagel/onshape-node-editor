{
  "name": "onshape-node-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build:app": "vite build",
    "build:app-dev": "vite build --mode development",
    "build:server": "node ./scripts/cleanServerBuild.cjs && tsc -p tsconfig.server.json && node ./scripts/copyServerAssets.cjs",
    "check:server-orphans": "node ./scripts/checkServerOrphans.cjs",
    "audit:gate": "node ./scripts/audit-gate.mjs",
    "build": "run-p type-check \"build:app\" \"build:server\"",
    "preview": "vite preview",
    "build-only": "vite build",
    "test": "vitest run",
    "type-check": "vue-tsc --build",
    "type-check:gate": "node scripts/typecheck-gate.mjs",
    "deploy:app": "node ./scripts/deployApp.cjs",
    "deploy:server": "pnpm run build:server && node ./scripts/deployServer.cjs",
    "scrape:docs": "node scripts/std-library-scrapper/scrapeFeatureScriptDocs.mjs",
    "scrape:docs-advanced": "node scripts/std-library-scrapper/scrapeFeatureScriptDocs-advanced.mjs",
    "scrape:docs-browser": "node scripts/std-library-scrapper/scrapeFeatureScriptDocs-advanced.mjs --browser",
    "organize:docs": "node scripts/std-library-scrapper/organizeLibrary.mjs",
    "scrape:all": "npm run scrape:docs && npm run organize:docs",
    "style-check": "node scripts/style-check.mjs",
    "fetch:feature-specs": "node scripts/fetch-feature-specs.mjs",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "verify:ui": "node qa/harness/ui-verify.mjs",
    "explore:ui": "node qa/harness/explorer.mjs",
    "build:qa-dashboard": "vite build --config qa/dashboard/vite.config.ts",
    "smoke:qa-dashboard": "node qa/dashboard/dashboard.smoke.mjs",
    "qa:node-chrome": "node qa/harness/node-chrome-check.mjs",
    "qa:defects": "node qa/harness/defect-checks.mjs",
    "qa:default-graph": "node qa/harness/default-graph-check.mjs",
    "qa:build-validation": "node qa/harness/build-validation-check.mjs",
    "qa:feature-panel": "node qa/harness/feature-panel-check.mjs",
    "qa:collapsed-grid": "node qa/harness/collapsed-grid-check.mjs",
    "qa:math-field": "node qa/harness/math-field-check.mjs",
    "qa:search-menus": "node qa/harness/search-menu-check.mjs",
    "qa:docs-nav": "node qa/harness/docs-nav-check.mjs",
    "qa:context-copy": "node qa/harness/context-copy-check.mjs",
    "qa:util-graph": "node qa/harness/util-graph-check.mjs",
    "qa:context-menu-audit": "node qa/harness/context-menu-audit.mjs",
    "qa:report": "node qa/harness/report.mjs",
    "qa:review": "node qa/review/review-packet.mjs"
  },
  "dependencies": {
    "@rwh/keystrokes": "^1.5.6",
    "@vueform/multiselect": "^2.6.11",
    "color": "^5.0.3",
    "dotenv": "^17.4.2",
    "katex": "^0.19.1",
    "onshape-typescript-fetch": "github:toebes/onshape-typescript-fetch",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.1.5",
    "rete-connection-plugin": "^2.0.5",
    "rete-context-menu-plugin": "^2.0.6",
    "rete-engine": "^2.1.1",
    "rete-render-utils": "^2.0.3",
    "rete-scopes-plugin": "^2.1.1",
    "rete-structures": "^2.0.3",
    "rete-vue-plugin": "^2.1.2",
    "sass": "^1.100.0",
    "sass-loader": "^17.1.0",
    "three": "^0.156.1",
    "vite-plugin-svgr": "^4.5.0",
    "vue": "^3.5.42",
    "vue3-select": "^0.1.2"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.19.19",
    "@types/node-fetch": "^2.6.13",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "adm-zip": "^0.5.17",
    "cheerio": "^1.2.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^8.0.4",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.3"
  }
}
