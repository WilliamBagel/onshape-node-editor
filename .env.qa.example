# Copy to .env.qa.local (gitignored) and fill in real values. Never commit .env.qa.local.
# Onshape API access key + secret key (https://cad.onshape.com appstore / dev portal API keys).
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# URL of the copied Onshape Standard Library document, e.g.
# https://cad.onshape.com/documents/<did>/w/<workspaceId>
# A bare document id also works if ONSHAPE_STD_WVMID is set below.
ONSHAPE_STD_DOC_URL=
# Optional: workspace/version/microversion overrides when the URL is ambiguous.
# ONSHAPE_STD_WVM=w
# ONSHAPE_STD_WVMID=
# Optional: label recorded in the cache's `source` field.
# ONSHAPE_STD_SOURCE_LABEL=Onshape Standard Library (copied document)
